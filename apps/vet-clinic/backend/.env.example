# Application
NODE_ENV=development
PORT=8081

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:password@localhost:5434/vet_clinic

# Security
CANADA_PHIPA_READY=false
JWT_SECRET=dev_secret_change_in_production_12345
JWT_EXPIRES_IN=24h

# Clerk Authentication (for pet owners)
CLERK_SECRET_KEY=your_clerk_secret_key
CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key

# CORS
CORS_ORIGIN=http://localhost:3002

# Adapters
POS_ADAPTER=mock
NOTIFICATION_ADAPTER=mock

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_MS=3600000

# Logging
LOG_LEVEL=info
LOG_REDACTION_ENABLED=true
