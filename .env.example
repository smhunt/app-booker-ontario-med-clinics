# Application
NODE_ENV=development
PORT=8080
FRONTEND_PORT=3000

# Database
DATABASE_URL=postgresql://oab_user:oab_password@db:5432/oab_dev

# Security - CRITICAL: Must be false by default
CANADA_PHIPA_READY=false

# JWT (ROTATE IN PRODUCTION)
JWT_SECRET=dev_secret_change_in_production_12345
JWT_EXPIRES_IN=24h

# Adapters
POS_ADAPTER=mock
NOTIFICATION_ADAPTER=mock

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_MS=3600000

# Logging
LOG_LEVEL=info
LOG_REDACTION_ENABLED=true

# CORS
CORS_ORIGIN=http://localhost:3000

# LLM Configuration (Chat Interface)
LLM_PROVIDER=claude
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here
LLM_MODEL=claude-sonnet-4-20250514
LLM_MAX_TOKENS=4096
CHAT_RATE_LIMIT_PER_MINUTE=20
CHAT_DAILY_TOKEN_BUDGET=50000
VOICE_SILENCE_TIMEOUT_MS=1500

# Future integrations (stubs only)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# SENDGRID_API_KEY=
# FHIR_BASE_URL=
