{
  "name": "app-booker-platform",
  "version": "2.0.0",
  "description": "Multi-industry appointment booking platform for healthcare and veterinary clinics",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*/backend",
    "apps/*/frontend"
  ],
  "scripts": {
    "dev:medical": "docker-compose -f apps/medical-clinic/docker-compose.yml up",
    "dev:vet": "docker-compose -f apps/vet-clinic/docker-compose.yml up",
    "dev": "npm run dev:medical",
    "dev:build": "docker-compose up --build",
    "down": "docker-compose down",
    "clean": "docker-compose down -v",
    "backend:medical": "npm run dev --workspace=apps/medical-clinic/backend",
    "frontend:medical": "npm run dev --workspace=apps/medical-clinic/frontend",
    "backend:vet": "npm run dev --workspace=apps/vet-clinic/backend",
    "frontend:vet": "npm run dev --workspace=apps/vet-clinic/frontend",
    "migrate:medical": "npm run migrate --workspace=apps/medical-clinic/backend",
    "seed:medical": "npm run seed --workspace=apps/medical-clinic/backend",
    "migrate:vet": "npm run migrate --workspace=apps/vet-clinic/backend",
    "seed:vet": "npm run seed --workspace=apps/vet-clinic/backend",
    "test": "npm run test --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "test:core": "npm run test --workspace=packages/core",
    "test:medical": "npm run test --workspace=packages/medical",
    "test:vet": "npm run test --workspace=packages/veterinary",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present"
  },
  "keywords": [
    "healthcare",
    "veterinary",
    "appointment-booking",
    "monorepo",
    "ontario",
    "phipa",
    "pipeda",
    "fhir"
  ],
  "author": "App Booker Platform",
  "license": "UNLICENSED",
  "devDependencies": {
    "patch-package": "^8.0.0"
  }
}
